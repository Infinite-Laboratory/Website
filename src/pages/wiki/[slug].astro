---
import { getCollection } from 'astro:content';
import WikiArticleView from '../../components/WikiArticleView.astro';
import { articlesFor, neighbours } from '../../lib/wiki';
import { variantsBySlug } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getCollection('wiki');
  const variants = variantsBySlug(all);
  const en = articlesFor(all, 'en');
  return en.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, ...neighbours(en, i), alternates: variants.get(entry.data.slug)?.th ? { th: `/th/wiki/${entry.data.slug}` } : {} },
  }));
}
const { entry, prev, next, alternates } = Astro.props;
---
<WikiArticleView entry={entry} prev={prev} next={next} lang="en" alternates={alternates} />
