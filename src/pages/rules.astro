---
import { getCollection } from 'astro:content';
import RulesView from '../components/RulesView.astro';
import { variantsBySlug } from '../lib/content';

const v = variantsBySlug(await getCollection('rules')).get('rules')!;
const alternates = v.th ? { th: '/th/rules' } : {};
---
<RulesView entry={v.en!} alternates={alternates} />
